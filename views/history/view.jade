extends ../layout
block content
  form.row.g-2.mb-3(method='GET', action='/history')
    .col-auto
      select.form-select(name='assetId', onchange='this.form.submit()')
        option(value='') -- Select Asset --
        each a in assets
          option(value=a.id, selected=(String(assetId) === String(a.id)))= a.assetCode + ' - ' + (a.make || '') + ' ' + (a.model || '')
  if asset
    .card.mb-3: .card-body
      h5 #{asset.assetCode} — #{asset.make} #{asset.model}
      div Serial: #{asset.serialNo} | Category: #{asset.Category ? asset.Category.name : '-'} | Branch: #{asset.Branch ? asset.Branch.name : '-'}
      div Current status: <strong>#{asset.status}</strong> | Purchase value: ₹#{asset.purchaseValue}
    table.table.table-striped.table-bordered.datatable
      thead: tr
        th Date
        th Event
        th Employee
        th Reason
        th Notes
      tbody
        each t in transactions
          tr
            td= t.txnDate
            td
              span.badge(class=(t.type === 'PURCHASE' ? 'bg-info' : t.type === 'ISSUE' ? 'bg-primary' : t.type === 'RETURN' ? 'bg-success' : 'bg-secondary'))= t.type
            td= t.Employee ? t.Employee.name : '-'
            td= t.reason
            td= t.notes
  else
    .alert.alert-info Select an asset to view its full history.
