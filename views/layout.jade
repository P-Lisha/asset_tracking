doctype html
html
  head
    title= title + ' | Asset Tracker'
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap')
    link(rel='stylesheet', href='/css/style.css')
  body
    .app-shell
      aside.sidebar
        a.sidebar-brand(href='/')
          i.sidebar-brand-icon.bi.bi-box-seam-fill
          span Asset Tracker
        nav.sidebar-nav
          a.sidebar-link(href='/')
            i.ico.bi.bi-speedometer2
            span.label Dashboard
          a.sidebar-link(href='/employees')
            i.ico.bi.bi-people
            span.label Employees
          a.sidebar-link(href='/assets')
            i.ico.bi.bi-pc-display
            span.label Assets
          a.sidebar-link(href='/categories')
            i.ico.bi.bi-tags
            span.label Categories
          a.sidebar-link(href='/branches')
            i.ico.bi.bi-building
            span.label Branches
          a.sidebar-link(href='/stock')
            i.ico.bi.bi-boxes
            span.label Stock
          a.sidebar-link(href='/issue')
            i.ico.bi.bi-box-arrow-right
            span.label Issue
          a.sidebar-link(href='/return')
            i.ico.bi.bi-box-arrow-in-left
            span.label Return
          a.sidebar-link(href='/scrap')
            i.ico.bi.bi-trash3
            span.label Scrap
          a.sidebar-link(href='/history')
            i.ico.bi.bi-clock-history
            span.label History
      main.app-main
        h3.page-title= title
        block content

    script(src='https://code.jquery.com/jquery-3.7.1.min.js')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js')
    script(src='https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js')
    script.
      $(function () {
        $('table.datatable').DataTable({ pageLength: 25 });
        var p = window.location.pathname;
        $('.sidebar-link').each(function () {
          var href = $(this).attr('href');
          if (href === '/' ? p === '/' : p.indexOf(href) === 0) $(this).addClass('active');
        });
      });
